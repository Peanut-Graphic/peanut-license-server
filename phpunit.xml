<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit 10 configuration (composer requires phpunit ^10).

  Testing scrub notes:
    - Old <filter><whitelist> removed in PHPUnit 10 -> replaced with <source>.
    - Removed convert* attributes (no longer valid in PHPUnit 10).

  The gated "Unit" suite is tests/phpunit/unit (~174 @test methods) running on
  the self-contained mock-WordPress bootstrap tests/phpunit/bootstrap.php. It
  needs no database or real WP — it stubs WP functions, a $wpdb mock, and loads
  the plugin's standalone download-token helpers in isolation. This is the suite
  CI blocks on.

  (An older, parallel tests/Unit tree exists from an earlier pass; it is no
  longer wired into a suite. tests/phpunit/unit is the canonical unit suite.)

  The "Integration" suite (tests/Integration) runs on the SAME self-contained
  mock-WordPress bootstrap — it exercises the REST request shape and the license
  activation/deactivation lifecycle with in-memory mocks, no database or real WP
  test library. It is a hard gate in CI alongside the Unit suite.
  See DOCUMENTATION/testing-standard/ for the shared standard.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/phpunit/bootstrap.php"
         colors="true"
         failOnWarning="false"
         failOnRisky="false"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/phpunit/unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <!-- Coverage source (replaces the removed <whitelist>). -->
    <source>
        <include>
            <directory suffix=".php">includes</directory>
        </include>
    </source>

    <php>
        <const name="PEANUT_LICENSE_TEST_MODE" value="true"/>
    </php>
</phpunit>

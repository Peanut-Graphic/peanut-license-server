{
    "name": "peanut-license-server-frontend",
    "private": true,
    "version": "1.3.3",
    "type": "module",
    "engines": {
        "node": "22.22.2",
        "npm": "10.9.7"
    },
    "packageManager": "npm@10.9.7",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:a11y": "vitest run -- a11y",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css}\"",
        "lint:a11y": "eslint src",
        "runtime:verify": "node ../scripts/verify-runtime-contract.cjs"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.62.0",
        "date-fns": "^4.1.0",
        "dompurify": "^3.4.13",
        "lucide-react": "^0.468.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.1.0",
        "recharts": "^2.15.0"
    },
    "browserslist": [
        "last 2 Chrome versions",
        "last 2 Firefox versions",
        "last 2 Safari versions",
        "last 2 Edge versions",
        "not dead"
    ],
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/dompurify": "^3.0.5",
        "@types/jest-axe": "^3.5.9",
        "@types/node": "^25.0.3",
        "@types/react": "^19.0.1",
        "@types/react-dom": "^19.0.1",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/coverage-v8": "^4.1.1",
        "eslint": "^9.39.0",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.6.0",
        "jest-axe": "^9.0.0",
        "jsdom": "^25.0.1",
        "prettier": "^3.0.0",
        "prettier-plugin-tailwindcss": "^0.5.0",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.59.4",
        "vite": "^6.0.3",
        "vitest": "^4.1.1"
    },
    "overrides": {
        "nanoid": "^3.3.18"
    }
}
